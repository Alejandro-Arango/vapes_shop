# =============================================================================
# CONFIGURACION DJANGO
# =============================================================================

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com
DJANGO_ADMIN_URL_PATH=panel-seguro/
DJANGO_ADMIN_ALLOWED_IPS=127.0.0.1,203.0.113.10


# =============================================================================
# BASE DE DATOS
# =============================================================================

# Opciones soportadas: sqlite, mysql
DJANGO_DB_ENGINE=mysql
DJANGO_DB_NAME=vapes_shop
DJANGO_DB_USER=vapes_user
DJANGO_DB_PASSWORD=cambia-esta-contrasena
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=3306

# Para desarrollo local puedes usar SQLite:
# DJANGO_DB_ENGINE=sqlite
# DJANGO_DB_NAME=backend/db.sqlite3


# =============================================================================
# SEGURIDAD PRODUCCION
# =============================================================================

DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_SESSION_COOKIE_AGE=1209600
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
DJANGO_USE_X_FORWARDED_PROTO=False
DJANGO_TRUST_X_FORWARDED_FOR=False


# =============================================================================
# CACHE / RATE LIMITS
# =============================================================================

# En desarrollo puedes usar locmem.
# En produccion usa database o un backend compartido equivalente.
DJANGO_CACHE_BACKEND=database
DJANGO_CACHE_TABLE=django_cache


# =============================================================================
# LIMITES DE USO
# =============================================================================

AUTH_THROTTLE_RATE=20/min
AUTH_USER_THROTTLE_RATE=10/min
CONTACT_THROTTLE_RATE=10/hour
CART_THROTTLE_RATE=60/min
CHECKOUT_THROTTLE_RATE=20/min
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=1048576
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=1048576
DJANGO_DATA_UPLOAD_MAX_NUMBER_FIELDS=1000
DJANGO_DATA_UPLOAD_MAX_NUMBER_FILES=20


# =============================================================================
# CONTACTO Y CORREO
# =============================================================================

CONTACT_WHATSAPP_NUMBER=573016604375
DEFAULT_FROM_EMAIL=Vape Shop <no-reply@tu-dominio.com>
CONTACT_NOTIFICATION_EMAIL=admin@tu-dominio.com
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.tu-proveedor.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=usuario-smtp
DJANGO_EMAIL_HOST_PASSWORD=cambia-esta-contrasena-smtp
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_TIMEOUT=10
DJANGO_PASSWORD_RESET_TIMEOUT=3600


# =============================================================================
# LOGGING
# =============================================================================

DJANGO_STORE_LOG_LEVEL=WARNING
DJANGO_REQUEST_LOG_LEVEL=ERROR
